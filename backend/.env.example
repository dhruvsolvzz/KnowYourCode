# ========================
# Backend Environment Variables
# ========================

# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/knowyourcode?retryWrites=true&w=majority

# JWT
JWT_SECRET=<generate-256-bit-random-secret>
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=<generate-256-bit-random-secret>
REFRESH_TOKEN_EXPIRES_IN=7d

# GitHub OAuth
GITHUB_CLIENT_ID=<your-github-client-id>
GITHUB_CLIENT_SECRET=<your-github-client-secret>
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback

# AI providers
GEMINI_API_KEY=<your-gemini-api-key>
OPENAI_API_KEY=<your-openai-api-key>
AI_PROVIDER=gemini

# Email (Nodemailer — Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your-gmail>@gmail.com
SMTP_PASS=<your-gmail-app-password>
EMAIL_FROM="KnowYourCode <noreply@knowyourcode.dev>"

# Frontend
FRONTEND_URL=http://localhost:5173

# Webhooks
WEBHOOK_BASE_URL=http://localhost:5000
